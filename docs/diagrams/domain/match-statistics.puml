@startuml Matchday Match Statistics
title Matchday V5 - Estadísticas del partido

skinparam componentStyle rectangle

component Goal
component Card
component PenaltyAttempt
component Shot
component Foul
component CornerKick
component Offside

class Match {
  +home/away_goal_count
  +home/away_yellow_card_count
  +home/away_red_card_count
  +home/away_shot_count
  +home/away_shot_on_target_count
  +home/away_save_count
  +home/away_foul_count
  +home/away_corner_count
  +home/away_offside_count
  +home_possession_percentage
}

artifact "MatchTeamStatistics\npossession\nyellow_cards / red_cards\nshots / shots_on_target\nsaves / fouls / corners / offsides" as ReadModel

Goal --> Match : marcador + tiro al arco
PenaltyAttempt --> Match : tiro / atajada
Shot --> Match : tiro / tiro al arco / atajada
Card --> Match : tarjetas
Foul --> Match : faltas
CornerKick --> Match : córners
Offside --> Match : fueras de juego
Match --> ReadModel : proyecta por equipo

note bottom of Match
  Los contadores son snapshots de lectura.
  Las tablas de eventos conservan el detalle.
  La posesión visitante es 100 - local.
end note
@enduml
