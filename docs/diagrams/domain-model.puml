@startuml Matchday Domain Model
title Matchday V5 - Modelo de dominio

hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "teams" {
  class Team {
    +UUID id
    +string name
    +string head_coach_name
    +UUID captain_id
    +datetime created_at
    +datetime updated_at
    --
    +create(name): Team
    +rename(name): void
    +set_head_coach(name): void
    +assign_captain(player): void
  }

  class Player {
    +UUID id
    +UUID team_id
    +string name
    +datetime created_at
    +datetime updated_at
    --
    +create(team_id, name): Player
    +rename(name): void
  }
}

package "matches" {
  enum MatchStatus {
    scheduled
    live
    finished
  }

  enum MatchPeriod {
    first_half
    halftime
    second_half
    extra_time_first_half
    extra_time_halftime
    extra_time_second_half
  }

  enum MatchFormation {
    4-3-3
    4-4-2
    4-2-3-1
    4-1-4-1
    3-5-2
    3-4-3
  }

  enum TeamSide {
    home
    away
  }

  enum CardType {
    yellow
    red
  }

  enum GoalType {
    regular
    penalty
    own_goal
  }

  enum PenaltyAttemptOutcome {
    missed
    saved
    hit_post
  }

  enum VarReviewReason {
    goal
    penalty
    direct_red_card
    mistaken_identity
  }

  enum VarReviewDecision {
    confirmed
    overturned
    changed
  }

  enum PenaltyShootoutStatus {
    in_progress
    decided
    finished
  }

  enum PenaltyKickOutcome {
    scored
    missed
  }

  enum PenaltyShootoutIneligibilityReason {
    initial_equalization
    injury
    sent_off
    opponent_reduction
  }

  enum MatchSquadRole {
    starter
    substitute
  }

  enum SentOffReason {
    direct_red
    second_yellow
  }

  class Match {
    +UUID id
    +UUID home_team_id
    +UUID away_team_id
    +string home_team_name
    +string away_team_name
    +string home_head_coach_name
    +string away_head_coach_name
    +MatchFormation home_formation
    +MatchFormation away_formation
    +string stadium_name
    +string referee_name
    +int home_goal_count
    +int away_goal_count
    +int home_card_count
    +int away_card_count
    +MatchStatus status
    +MatchPeriod current_period
    +int current_minute
    +int current_added_minute
    +datetime scheduled_at
    +datetime started_at
    +datetime finished_at
    --
    +schedule(...): Match
    +set_formation(...): void
    +add_squad_player(...): MatchSquadPlayer
    +start(...): void
    +end_first_half(): void
    +start_second_half(): void
    +update_clock(...): void
    +finish(...): void
    +register_goal(...): Goal
    +register_penalty_attempt(...): PenaltyAttempt
    +register_injury(...): Injury
    +register_var_review(...): VarReview
    +register_card(...): Card
    +disallow_goal(...): void
    +rescind_card(...): void
  }

  class MatchSquadPlayer {
    +UUID id
    +UUID match_id
    +UUID player_id
    +TeamSide team_side
    +int shirt_number
    +MatchSquadRole role
    +bool is_on_field
    +bool is_sent_off
    +SentOffReason sent_off_reason
    +bool is_captain
    --
    +send_off(): void
    +reinstate(): void
  }

  class MatchSubstitution {
    +UUID id
    +UUID match_id
    +UUID player_out_id
    +UUID player_in_id
      +TeamSide team_side
      +SubstitutionReason reason
    +MatchPeriod period
    +int minute
    +int added_minute
  }

  enum SubstitutionReason {
    tactical
    injury
  }

  class Goal {
    +UUID id
    +UUID match_id
    +UUID player_id
    +UUID assist_player_id
    +TeamSide team_side
    +string player_name
    +string assist_player_name
    +MatchPeriod period
    +GoalType goal_type
    +int minute
    +int added_minute
    +datetime disallowed_at
    --
    +disallow(...): void
  }

  class PenaltyAttempt {
    +UUID id
    +UUID match_id
    +UUID player_id
    +string player_name
    +TeamSide team_side
    +PenaltyAttemptOutcome outcome
    +MatchPeriod period
    +int minute
    +int added_minute
  }

  class Injury {
    +UUID id
    +UUID match_id
    +UUID player_id
    +string player_name
    +TeamSide team_side
    +MatchPeriod period
    +int minute
    +int added_minute
  }

  class VarReview {
    +UUID id
    +UUID match_id
    +TeamSide team_side
    +VarReviewReason reason
    +VarReviewDecision decision
    +UUID reviewed_event_id
    +MatchPeriod period
    +int minute
    +int added_minute
  }

  class Card {
    +UUID id
    +UUID match_id
    +UUID player_id
    +TeamSide team_side
    +string player_name
    +CardType card_type
    +MatchPeriod period
    +int minute
    +int added_minute
    +datetime rescinded_at
    --
    +rescind(...): void
  }

  class PenaltyShootout {
    +UUID id
    +UUID match_id
    +PenaltyShootoutStatus status
    +TeamSide starting_team_side
    +int home_score
    +int away_score
    +int home_kick_count
    +int away_kick_count
    +TeamSide winner_team_side
    --
    +next_team_side: TeamSide?
    +record_kick(...): void
    +finish(...): void
  }

  class PenaltyShootoutKick {
    +UUID id
    +UUID shootout_id
    +UUID player_id
    +string player_name
    +TeamSide team_side
    +int sequence_number
    +PenaltyKickOutcome outcome
  }

  class PenaltyShootoutParticipant {
    +UUID id
    +UUID shootout_id
    +UUID player_id
    +TeamSide team_side
    +bool is_eligible
    +PenaltyShootoutIneligibilityReason ineligibility_reason
    +datetime became_ineligible_at
  }
}

Team "1" -- "0..*" Player : plantilla
Team "0..1" --> "0..1" Player : capitán habitual
Team "1" <-- "0..*" Match : local
Team "1" <-- "0..*" Match : visitante
Match "1" *-- "11..*" MatchSquadPlayer : convocatoria
Match "1" *-- "0..*" MatchSubstitution : sustituciones
Player "1" <-- "0..*" MatchSquadPlayer
MatchSquadPlayer "1" <-- "0..*" MatchSubstitution : sale
MatchSquadPlayer "1" <-- "0..*" MatchSubstitution : entra
Match "1" *-- "0..*" Goal
Match "1" *-- "0..*" Card
Match "1" *-- "0..*" PenaltyAttempt
Match "1" *-- "0..*" Injury
Match "1" *-- "0..*" VarReview
Match "1" *-- "0..1" PenaltyShootout
PenaltyShootout "1" *-- "0..*" PenaltyShootoutKick
PenaltyShootout "1" *-- "1..*" PenaltyShootoutParticipant : habilitados
Player "1" <-- "0..*" Goal
Player "0..1" <-- "0..*" Goal : asistencia
Player "1" <-- "0..*" Card
Player "1" <-- "0..*" PenaltyAttempt
Player "1" <-- "0..*" Injury
Player "1" <-- "0..*" PenaltyShootoutKick
Player "1" <-- "0..*" PenaltyShootoutParticipant
Match --> MatchStatus
Match --> MatchPeriod
Match --> MatchFormation
MatchSquadPlayer --> TeamSide
MatchSquadPlayer --> MatchSquadRole
MatchSquadPlayer --> SentOffReason
  MatchSubstitution --> TeamSide
  MatchSubstitution --> SubstitutionReason
Goal --> TeamSide
Goal --> GoalType
PenaltyAttempt --> PenaltyAttemptOutcome
PenaltyAttempt --> TeamSide
Injury --> TeamSide
VarReview --> TeamSide
VarReview --> VarReviewReason
VarReview --> VarReviewDecision
Card --> TeamSide
Card --> CardType
PenaltyShootout --> PenaltyShootoutStatus
PenaltyShootout --> TeamSide
PenaltyShootoutKick --> TeamSide
PenaltyShootoutKick --> PenaltyKickOutcome
PenaltyShootoutParticipant --> TeamSide
PenaltyShootoutParticipant --> PenaltyShootoutIneligibilityReason

note right of Match
  Los nombres de equipos son snapshots.
  Formación y alineación solo cambian
  mientras el partido está programado.
end note

note bottom of MatchSquadPlayer
  Por equipo y partido:
  - exactamente 11 titulares
  - cero o más suplentes
  - dorsales únicos
  - cero o un capitán titular
  Si captain_id se omite, se usa el
  habitual solo cuando está alineado.
  Nunca se selecciona otro automáticamente.
end note

note bottom of PenaltyShootout
  Regla 10 de IFAB.
  El equipo inicial queda persistido.
  El siguiente turno se calcula mientras
  la tanda está activa. Un jugador solo
  repite tras lanzar todos los habilitados.
  Si los equipos terminan con cantidades
  distintas, el mayor excluye la diferencia.
  Si alguien queda fuera durante la tanda,
  el rival excluye otro antes de continuar.
end note
@enduml
