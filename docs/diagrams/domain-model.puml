@startuml Matchday Domain Overview
title Matchday - Vista general del dominio

skinparam componentStyle rectangle
skinparam linetype ortho

package teams {
  component Team
  component Player
}

package matches {
  component "Match Core\nestado + periodos + alineaciones" as MatchCore
  component "Match Events\ncronología individual" as Events
  component "Match Statistics\ncontadores por equipo" as Statistics
  component "Penalty Shootout\nparticipantes + lanzamientos" as Shootout
}

Team --> Player : plantilla
Team --> MatchCore : local / visitante
Player --> MatchCore : convocatoria
MatchCore --> Events
Events --> Statistics : actualizan snapshots
MatchCore --> Shootout

note bottom of MatchCore
  Ver domain/match-core.puml
  y domain/teams.puml
end note
note bottom of Events
  Ver domain/match-events.puml
end note
note bottom of Statistics
  Ver domain/match-statistics.puml
end note
note bottom of Shootout
  Ver domain/penalty-shootout.puml
end note

package news {
  component News
}
package tournaments {
  component Tournament
  component Season
  component Phase
  component Group
  component GroupEntry
  component Fixture
}
News --> Team : equipo opcional
Tournament --> Season
Season --> Team : inscritos
Season --> Phase
Phase --> Group
Group --> GroupEntry
GroupEntry --> Team
Phase --> Fixture
Fixture --> Group : opcional
Fixture --> MatchCore : Match existente (OneToOne)
note bottom of News
  Ver domain/news.puml y news-lifecycle.puml
end note
note bottom of Tournament
  Ver domain/tournaments.puml
end note

@enduml
