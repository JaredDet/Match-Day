@startuml Matchday Domain Model
title Matchday V4 - Modelo de dominio

hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "teams" {
  class Team {
    +UUID id
    +string name
    +UUID captain_id
    +datetime created_at
    +datetime updated_at
    --
    +create(name): Team
    +rename(name): void
    +assign_captain(player): void
  }

  class Player {
    +UUID id
    +UUID team_id
    +string name
    +datetime created_at
    +datetime updated_at
    --
    +create(team_id, name): Player
    +rename(name): void
  }
}

package "matches" {
  enum MatchStatus {
    scheduled
    live
    finished
  }

  enum MatchFormation {
    4-3-3
    4-4-2
    4-2-3-1
    4-1-4-1
    3-5-2
    3-4-3
  }

  enum TeamSide {
    home
    away
  }

  enum CardType {
    yellow
    red
  }

  enum MatchSquadRole {
    starter
    substitute
  }

  class Match {
    +UUID id
    +UUID home_team_id
    +UUID away_team_id
    +string home_team_name
    +string away_team_name
    +MatchFormation home_formation
    +MatchFormation away_formation
    +string stadium_name
    +string referee_name
    +int home_goal_count
    +int away_goal_count
    +int home_card_count
    +int away_card_count
    +MatchStatus status
    +datetime scheduled_at
    +datetime started_at
    +datetime finished_at
    --
    +schedule(...): Match
    +set_formation(...): void
    +add_squad_player(...): MatchSquadPlayer
    +start(...): void
    +finish(...): void
    +register_goal(...): Goal
    +register_card(...): Card
    +disallow_goal(...): void
    +rescind_card(...): void
  }

  class MatchSquadPlayer {
    +UUID id
    +UUID match_id
    +UUID player_id
    +TeamSide team_side
    +int shirt_number
    +MatchSquadRole role
    +bool is_on_field
    +bool is_captain
  }

  class MatchSubstitution {
    +UUID id
    +UUID match_id
    +UUID player_out_id
    +UUID player_in_id
    +TeamSide team_side
    +int minute
  }

  class Goal {
    +UUID id
    +UUID match_id
    +UUID player_id
    +TeamSide team_side
    +string player_name
    +int minute
    +datetime disallowed_at
    --
    +disallow(...): void
  }

  class Card {
    +UUID id
    +UUID match_id
    +UUID player_id
    +TeamSide team_side
    +string player_name
    +CardType card_type
    +int minute
    +datetime rescinded_at
    --
    +rescind(...): void
  }
}

Team "1" -- "0..*" Player : plantilla
Team "0..1" --> "0..1" Player : capitán habitual
Team "1" <-- "0..*" Match : local
Team "1" <-- "0..*" Match : visitante
Match "1" *-- "11..*" MatchSquadPlayer : convocatoria
Match "1" *-- "0..*" MatchSubstitution : sustituciones
Player "1" <-- "0..*" MatchSquadPlayer
MatchSquadPlayer "1" <-- "0..*" MatchSubstitution : sale
MatchSquadPlayer "1" <-- "0..*" MatchSubstitution : entra
Match "1" *-- "0..*" Goal
Match "1" *-- "0..*" Card
Player "1" <-- "0..*" Goal
Player "1" <-- "0..*" Card
Match --> MatchStatus
Match --> MatchFormation
MatchSquadPlayer --> TeamSide
MatchSquadPlayer --> MatchSquadRole
MatchSubstitution --> TeamSide
Goal --> TeamSide
Card --> TeamSide
Card --> CardType

note right of Match
  Los nombres de equipos son snapshots.
  Formación y alineación solo cambian
  mientras el partido está programado.
end note

note bottom of MatchSquadPlayer
  Por equipo y partido:
  - exactamente 11 titulares
  - cero o más suplentes
  - dorsales únicos
  - cero o un capitán titular
  Si captain_id se omite, se usa el
  habitual solo cuando está alineado.
  Nunca se selecciona otro automáticamente.
end note
@enduml
