@startuml Matchday Inputs Outputs Overview
title Matchday - Vista general de entradas y salidas

left to right direction
skinparam componentStyle rectangle

component "Team API" as TeamApi
component "Match Lifecycle API" as LifecycleApi
component "Match Event API" as EventApi
component "Query API" as QueryApi

artifact "Team / Player requests" as TeamInput
artifact "Match configuration" as MatchInput
artifact "Timed event requests" as EventInput
artifact "Summary / Detail responses" as Output

TeamInput --> TeamApi
MatchInput --> LifecycleApi
EventInput --> EventApi
TeamApi --> Output
LifecycleApi --> Output
EventApi --> Output
QueryApi --> Output

note bottom of TeamApi
  Ver api/teams.puml
end note
note bottom of LifecycleApi
  Ver api/match-lifecycle.puml
end note
note bottom of EventApi
  Ver api/match-events.puml
end note
note bottom of QueryApi
  Ver api/match-queries.puml
end note

component "News API" as NewsApi
component "Tournament API" as TournamentApi
artifact "News requests / publication dates" as NewsInput
artifact "Tournament, season, phase, group, entry, fixture requests" as TournamentInput
artifact "News list/detail / status" as NewsOutput
artifact "Structure / standings / bracket / fixture responses" as TournamentOutput
NewsInput --> NewsApi
NewsApi --> NewsOutput
TournamentInput --> TournamentApi
TournamentApi --> TournamentOutput
note bottom of NewsApi
  Ver api/news.puml
end note
note bottom of TournamentApi
  Ver api/tournaments.puml
end note


component "Recommendations API" as RecApi
artifact "GET navigation headers / POST heartbeat context / visitor cookie" as RecInput
artifact "news / matches / tournaments / discovery + reasons" as RecOutput
RecInput --> RecApi
RecApi --> RecOutput
note bottom of RecApi
  Ver api/recommendations.puml
end note

@enduml
