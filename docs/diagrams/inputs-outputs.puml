@startuml Matchday Inputs and Outputs
title Matchday V3 - Entradas y salidas
left to right direction
skinparam componentStyle rectangle
skinparam linetype ortho

package "Team Commands" {
  component "POST /teams" as CreateTeamApi
  component "CreateTeamUseCase" as CreateTeam
  artifact "name" as CreateTeamInput
  artifact "201: id" as CreateTeamOutput
  component "PATCH /teams/{id}" as UpdateTeamApi
  component "UpdateTeamUseCase" as UpdateTeam
  artifact "name" as UpdateTeamInput
  component "POST /teams/{id}/players" as RegisterPlayerApi
  component "RegisterPlayerUseCase" as RegisterPlayer
  artifact "name" as RegisterPlayerInput
  artifact "201: id" as RegisterPlayerOutput
  component "POST /teams/{id}/squad" as RegisterSquadApi
  component "RegisterTeamSquadUseCase" as RegisterSquad
  artifact "players[1..50]: name" as RegisterSquadInput
  artifact "201: ids[]" as RegisterSquadOutput
  component "PATCH /teams/{id}/players/{player_id}" as UpdatePlayerApi
  component "UpdatePlayerUseCase" as UpdatePlayer
  artifact "player name" as UpdatePlayerInput
  component "PUT /teams/{id}/captain" as SetCaptainApi
  component "SetTeamCaptainUseCase" as SetCaptain
  artifact "player_id" as SetCaptainInput
  artifact "204 No Content" as EmptyTeamOutput
}

package "Team and Player Queries" {
  component "GET /teams" as ListTeamsApi
  component "ListTeamsQuery" as ListTeams
  artifact "search?" as ListTeamsInput
  artifact "teams[]\nlast_match + next_match" as ListTeamsOutput
  component "GET /teams/{id}" as GetTeamApi
  component "GetTeamQuery" as GetTeam
  artifact "team detail\nstats + players + last 5" as GetTeamOutput
  component "GET /players" as ListPlayersApi
  component "ListPlayersQuery" as ListPlayers
  artifact "search? + team_id?" as ListPlayersInput
  artifact "players[]\nteam + captain + appearances + goals" as ListPlayersOutput
  component "GET /players/{id}" as GetPlayerApi
  component "GetPlayerQuery" as GetPlayer
  artifact "player detail\nstats + last 5 matches" as GetPlayerOutput
}

package "Match Commands" {
  component "POST /matches" as CreateMatchApi
  component "CreateMatchUseCase" as CreateMatch
  artifact "home_team_id + away_team_id\nscheduled_at + stadium? + referee?" as CreateMatchInput
  artifact "201: id" as CreateMatchOutput
  component "PATCH /matches/{id}/details" as UpdateDetailsApi
  component "UpdateMatchDetailsUseCase" as UpdateDetails
  artifact "stadium_name? + referee_name?" as UpdateDetailsInput
  component "PUT /matches/{id}/lineups/{side}" as SetLineupApi
  component "SetMatchLineupUseCase" as SetLineup
  artifact "formation + captain_id?\nplayers[11] + substitutes[]:\nplayer_id + shirt_number" as SetLineupInput
  component "POST /matches/{id}/start" as StartApi
  component "StartMatchUseCase" as StartMatch
  component "POST /matches/{id}/finish" as FinishApi
  component "FinishMatchUseCase" as FinishMatch
  component "POST /matches/{id}/goals" as GoalApi
  component "RegisterGoalUseCase" as RegisterGoal
  artifact "player_id + minute" as GoalInput
  artifact "201: event id" as EventOutput
  component "POST /matches/{id}/cards" as CardApi
  component "RegisterCardUseCase" as RegisterCard
  artifact "player_id + card_type + minute" as CardInput
  component "POST /matches/{id}/substitutions" as SubstitutionApi
  component "RegisterSubstitutionUseCase" as RegisterSubstitution
  artifact "player_out_id + player_in_id + minute" as SubstitutionInput
  component "POST /goals/{goal_id}/disallow" as DisallowApi
  component "DisallowGoalUseCase" as DisallowGoal
  component "POST /cards/{card_id}/rescind" as RescindApi
  component "RescindCardUseCase" as RescindCard
  artifact "204 No Content" as EmptyMatchOutput
}

package "Match Queries" {
  component "GET /matches" as ListMatchesApi
  component "ListMatchesQuery" as ListMatches
  artifact "status? + date?" as ListMatchesInput
  artifact "matches[]\nteams + score + formation" as ListMatchesOutput
  component "GET /matches/{id}" as GetMatchApi
  component "GetMatchQuery" as GetMatch
  artifact "match detail\nteams + lineups + events" as GetMatchOutput
}

CreateTeamInput --> CreateTeamApi
CreateTeamApi --> CreateTeam
CreateTeam --> CreateTeamOutput
UpdateTeamInput --> UpdateTeamApi
UpdateTeamApi --> UpdateTeam
UpdateTeam --> EmptyTeamOutput
RegisterPlayerInput --> RegisterPlayerApi
RegisterPlayerApi --> RegisterPlayer
RegisterPlayer --> RegisterPlayerOutput
RegisterSquadInput --> RegisterSquadApi
RegisterSquadApi --> RegisterSquad
RegisterSquad --> RegisterSquadOutput
UpdatePlayerInput --> UpdatePlayerApi
UpdatePlayerApi --> UpdatePlayer
UpdatePlayer --> EmptyTeamOutput
SetCaptainInput --> SetCaptainApi
SetCaptainApi --> SetCaptain
SetCaptain --> EmptyTeamOutput
ListTeamsInput --> ListTeamsApi
ListTeamsApi --> ListTeams
ListTeams --> ListTeamsOutput
GetTeamApi --> GetTeam
GetTeam --> GetTeamOutput
ListPlayersInput --> ListPlayersApi
ListPlayersApi --> ListPlayers
ListPlayers --> ListPlayersOutput
GetPlayerApi --> GetPlayer
GetPlayer --> GetPlayerOutput
CreateMatchInput --> CreateMatchApi
CreateMatchApi --> CreateMatch
CreateMatch --> CreateMatchOutput
UpdateDetailsInput --> UpdateDetailsApi
UpdateDetailsApi --> UpdateDetails
UpdateDetails --> EmptyMatchOutput
SetLineupInput --> SetLineupApi
SetLineupApi --> SetLineup
SetLineup --> EmptyMatchOutput
StartApi --> StartMatch
StartMatch --> EmptyMatchOutput
FinishApi --> FinishMatch
FinishMatch --> EmptyMatchOutput
GoalInput --> GoalApi
GoalApi --> RegisterGoal
RegisterGoal --> EventOutput
CardInput --> CardApi
CardApi --> RegisterCard
RegisterCard --> EventOutput
SubstitutionInput --> SubstitutionApi
SubstitutionApi --> RegisterSubstitution
RegisterSubstitution --> EventOutput
DisallowApi --> DisallowGoal
DisallowGoal --> EmptyMatchOutput
RescindApi --> RescindCard
RescindCard --> EmptyMatchOutput
ListMatchesInput --> ListMatchesApi
ListMatchesApi --> ListMatches
ListMatches --> ListMatchesOutput
GetMatchApi --> GetMatch
GetMatch --> GetMatchOutput

note right of SetLineupInput
  Sin captain_id se intenta usar el habitual.
  Si no está alineado, queda sin capitán
  y se registra una advertencia.
end note
@enduml
