@startuml Matchday Use Case Overview
title Matchday V5 - Vista general de casos de uso

left to right direction
actor Administrador
actor Espectador

rectangle Matchday {
  usecase "Administrar equipos\ny jugadores" as Teams
  usecase "Configurar y controlar\nel partido" as Lifecycle
  usecase "Registrar eventos\ny estadísticas" as Events
  usecase "Administrar tanda\nde penales" as Shootout
  usecase "Consultar partidos,\nequipos y jugadores" as Queries
}

Administrador --> Teams
Administrador --> Lifecycle
Administrador --> Events
Administrador --> Shootout
Administrador --> Queries
Espectador --> Queries

note bottom of Teams
  Ver use-cases/teams.puml
end note
note bottom of Lifecycle
  Ver use-cases/match-lifecycle.puml
end note
note bottom of Events
  Ver use-cases/match-events.puml
end note
note bottom of Shootout
  Ver use-cases/penalty-shootout.puml
end note
note bottom of Queries
  Ver use-cases/match-queries.puml
end note
@enduml
