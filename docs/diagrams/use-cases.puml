@startuml Matchday Use Cases
title Matchday V5 - Casos de uso

left to right direction
skinparam packageStyle rectangle

actor Administrador as Admin
actor Espectador as Viewer

rectangle "Teams" {
  usecase "Crear equipo" as CreateTeam
  usecase "Actualizar equipo" as UpdateTeam
  usecase "Registrar jugador" as RegisterPlayer
  usecase "Cargar nómina" as RegisterSquad
  usecase "Asignar capitán habitual" as SetCaptain
  usecase "Actualizar jugador" as UpdatePlayer
  usecase "Listar equipos" as ListTeams
  usecase "Ver detalle del equipo" as GetTeam
  usecase "Listar jugadores" as ListPlayers
  usecase "Ver detalle del jugador" as GetPlayer
}

rectangle "Matches" {
  usecase "Crear partido" as CreateMatch
  usecase "Configurar o reemplazar\nformación y alineación" as SetLineup
  usecase "Iniciar partido" as StartMatch
  usecase "Avanzar periodo esperado" as AdvancePeriod
  usecase "Actualizar reloj oficial" as UpdateClock
  usecase "Finalizar partido" as FinishMatch
  usecase "Registrar gol" as RegisterGoal
  usecase "Registrar penal no convertido" as RegisterPenaltyAttempt
  usecase "Registrar lesión" as RegisterInjury
  usecase "Registrar revisión VAR" as RegisterVarReview
  usecase "Anular gol" as DisallowGoal
  usecase "Registrar tarjeta" as RegisterCard
  usecase "Registrar sustitución" as RegisterSubstitution
  usecase "Retirar tarjeta" as RescindCard
  usecase "Actualizar estadio y árbitro" as UpdateDetails
  usecase "Listar partidos" as ListMatches
  usecase "Ver detalle del partido" as GetMatch
  usecase "Iniciar tanda de penales" as StartShootout
  usecase "Registrar lanzamiento de penal" as RegisterShootoutKick
  usecase "Reducir participantes de la tanda" as ReduceShootoutParticipants
  usecase "Finalizar tanda de penales" as FinishShootout
}

Admin --> CreateTeam
Admin --> UpdateTeam
Admin --> RegisterPlayer
Admin --> RegisterSquad
Admin --> SetCaptain
Admin --> UpdatePlayer
Admin --> ListTeams
Admin --> GetTeam
Admin --> ListPlayers
Admin --> GetPlayer
Admin --> CreateMatch
Admin --> SetLineup
Admin --> StartMatch
Admin --> AdvancePeriod
Admin --> UpdateClock
Admin --> FinishMatch
Admin --> RegisterGoal
Admin --> RegisterPenaltyAttempt
Admin --> RegisterInjury
Admin --> RegisterVarReview
Admin --> DisallowGoal
Admin --> RegisterCard
Admin --> RegisterSubstitution
Admin --> RescindCard
Admin --> UpdateDetails
Admin --> ListMatches
Admin --> GetMatch
Admin --> StartShootout
Admin --> RegisterShootoutKick
Admin --> ReduceShootoutParticipants
Admin --> FinishShootout
Viewer --> ListMatches
Viewer --> GetMatch
Viewer --> ListTeams
Viewer --> GetTeam
Viewer --> ListPlayers
Viewer --> GetPlayer

StartShootout ..> AdvancePeriod : tiempo reglamentario o prórroga completados
RegisterShootoutKick ..> StartShootout : tanda activa
ReduceShootoutParticipants ..> StartShootout : lesión o expulsión
FinishShootout ..> RegisterShootoutKick : ganador decidido

note right of StartShootout
  Recibe el equipo que comienza y, cuando
  corresponda, los jugadores excluidos para
  igualar la cantidad de habilitados.
end note

RegisterSquad ..> CreateTeam : equipo existente
SetLineup ..> RegisterSquad : jugadores existentes
StartMatch ..> SetLineup : configuración previa
@enduml
