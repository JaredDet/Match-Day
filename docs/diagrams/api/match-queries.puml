@startuml Matchday Match Query API
title Matchday V5 - Salidas de consultas de partidos

left to right direction
skinparam componentStyle rectangle

component "GET /matches" as ListApi
artifact "MatchSummary[]\nstatus + scheduled_at\nteams + score + goals + formation\nlive period and minute" as ListOutput

component "GET /matches/{id}" as DetailApi
artifact "MatchDetail" as Detail
artifact "home_team / away_team\nscore + coach + formation + lineup" as Teams
artifact "statistics\npossession + cards + shots\nsaves + fouls + corners + offsides" as Statistics
artifact "events[]\nunified chronological timeline" as Events
artifact "penalty_shootout?" as Shootout

ListApi --> ListOutput
DetailApi --> Detail
Detail --> Teams
Detail --> Statistics
Detail --> Events
Detail --> Shootout
@enduml
