@startuml NewsAPI
title Noticias - Contratos API (prefijo /api)
left to right direction
skinparam componentStyle rectangle
component "POST /news/" as Create
component "PATCH /news/{id}/" as Update
component "POST /news/{id}/schedule/" as Schedule
component "POST /news/{id}/publish/
POST /news/{id}/unschedule/
DELETE /news/{id}/" as Actions
component "GET /news/
GET /news/{id}/" as Read
artifact "title, content
team_id?, cover_image?" as CreateInput
artifact "title, content
cover_image? (omitir conserva; null quita)" as UpdateInput
artifact "scheduled_at: ISO 8601" as ScheduleInput
artifact "status?, team_id?
published_from?, published_to?" as Filters
artifact "201: {id}" as Created
artifact "204: sin cuerpo" as Changed
artifact "id, title, team_id, cover_image, content
status, scheduled_at, published_at" as Output
CreateInput --> Create
UpdateInput --> Update
ScheduleInput --> Schedule
Filters --> Read
Create --> Created
Update --> Changed
Schedule --> Changed
Actions --> Changed
Read --> Output
@enduml
