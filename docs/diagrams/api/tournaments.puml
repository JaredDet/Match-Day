@startuml TournamentsAPI
title Torneos - Contratos API (prefijo /api)
left to right direction
skinparam componentStyle rectangle
component "POST /tournaments/
GET /tournaments/
GET /tournaments/{slug}/" as Tournaments
component "POST /tournament-seasons/
GET /tournament-seasons/[{id}/]
GET /tournaments/{slug}/seasons/" as Seasons
component "POST y GET /tournament-phases/
POST y GET /tournament-groups/
POST y GET /tournament-group-entries/
POST y GET /tournament-fixtures/" as Structure
component "PUT /tournament-phases/{id}/status/" as Status
component "GET /tournament-seasons/{id}/groups/" as Groups
component "GET /tournament-seasons/{id}/bracket/" as Bracket
component "GET /tournament-seasons/{id}/matches/" as Matches
artifact "slug, name, country, category\nmax_teams_per_group? (default 4)" as TournamentInput
artifact "tournament: UUID, name, teams?: UUID[]" as SeasonInput
artifact "Contratos por entidad; UUIDs relacionados
Filtros: season, phase, group segun recurso" as StructureInput
artifact "201 {id}; GET 200 resumen/detalle" as Output
artifact "status: scheduled | live | finished
Respuesta 204" as StatusContract
artifact "Grupos con rows: id,w,d,l,gf,ga
played,goal_difference,points,qualified" as GroupOutput
artifact "rounds: [{id,name,ties}]
third: cruce o null
Cruce: id,home,away,homeScore,awayScore,penalties?" as BracketOutput
artifact "Fixtures: id,phase,group,match,position,matchday" as MatchOutput
TournamentInput --> Tournaments
SeasonInput --> Seasons
StructureInput --> Structure
Tournaments --> Output
Seasons --> Output
Structure --> Output
StatusContract --> Status
Groups --> GroupOutput
Bracket --> BracketOutput
Matches --> MatchOutput
component "POST /tournament-seasons/{id}/teams/
DELETE /tournament-seasons/{id}/teams/{team_id}/" as Members
component "PATCH /tournament-phases/{id}/
PATCH /tournament-groups/{id}/
PATCH /tournament-fixtures/{id}/" as Edit
component "DELETE fases, grupos, fixtures, group-entries por UUID" as Delete
component "PUT /tournament-groups/{id}/tie-break/" as TieBreak
component "POST /tournament-seasons/{id}/generate-bracket/" as Generate
component "POST /tournament-seasons/{id}/advance-bracket/" as Advance
artifact "starts_at
team_ids O source_phase_id
round_interval_days? (7), third_place? (true)" as GenerateInput
artifact "201 {phase_ids}" as Generated
artifact "200 {created_matches}" as Advanced
artifact "team_ids: orden completo del grupo" as TieBreakInput
artifact "204 sin cuerpo; 409 si estructura protegida" as Changed
GenerateInput --> Generate
Generate --> Generated
Advance --> Advanced
TieBreakInput --> TieBreak
TieBreak --> Changed
Members --> Changed
Edit --> Changed
Delete --> Changed
@enduml
