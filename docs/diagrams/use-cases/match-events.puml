@startuml Matchday Match Event Use Cases
title Matchday V5 - Casos de uso de eventos

left to right direction
actor Operador

rectangle "Cronología" {
  usecase "Registrar gol" as Goal
  usecase "Anular gol" as DisallowGoal
  usecase "Registrar tarjeta" as Card
  usecase "Retirar tarjeta" as RescindCard
  usecase "Registrar sustitución" as Substitution
  usecase "Registrar penal no convertido" as PenaltyAttempt
  usecase "Registrar lesión" as Injury
  usecase "Registrar revisión VAR" as Var
  usecase "Registrar falta" as Foul
  usecase "Registrar córner" as Corner
  usecase "Registrar fuera de juego" as Offside
  usecase "Registrar tiro" as Shot
  usecase "Actualizar posesión" as Possession
}

Operador --> Goal
Operador --> DisallowGoal
Operador --> Card
Operador --> RescindCard
Operador --> Substitution
Operador --> PenaltyAttempt
Operador --> Injury
Operador --> Var
Operador --> Foul
Operador --> Corner
Operador --> Offside
Operador --> Shot
Operador --> Possession

DisallowGoal ..> Goal : corrige marcador y estadísticas
RescindCard ..> Card : corrige expulsión y estadísticas
@enduml
