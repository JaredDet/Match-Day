@startuml Matchday Match Lifecycle Use Cases
title Matchday V5 - Casos de uso del ciclo del partido

left to right direction
actor Operador
actor "Monitor (30 s)" as Monitor

rectangle Matches {
  usecase "Crear partido" as CreateMatch
  usecase "Actualizar detalles" as UpdateDetails
  usecase "Configurar alineación" as SetLineup
  usecase "Iniciar partido" as StartMatch
  usecase "Iniciar periodo" as StartPeriod
  usecase "Anunciar tiempo añadido" as AddedTime
  usecase "Cerrar periodo" as EndPeriod
  usecase "Finalizar partido" as FinishMatch
  usecase "Sincronizar relojes" as SynchronizeClock
}

Operador --> CreateMatch
Operador --> UpdateDetails
Operador --> SetLineup
Operador --> StartMatch
Operador --> StartPeriod
Operador --> AddedTime
Operador --> EndPeriod
Operador --> FinishMatch
Monitor --> SynchronizeClock

StartMatch ..> SetLineup : requiere 11 titulares\ny formación por equipo
EndPeriod ..> AddedTime : respeta el deadline anunciado
StartPeriod ..> EndPeriod : requiere periodo anterior cerrado
SynchronizeClock ..> EndPeriod : avisa; no cierra automáticamente
@enduml
