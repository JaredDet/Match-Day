@startuml MatchdaySystemContext
!include <C4/C4_Context>

title Matchday - C4 nivel 1: contexto del sistema

LAYOUT_LEFT_RIGHT()

Person(visitor, "Visitante", "Consulta contenido deportivo y recibe recomendaciones anónimas.")
Person(editor, "Editor", "Crea y publica noticias.")
Person(admin, "Administrador", "Gestiona equipos, partidos y torneos.")

System(matchday, "Matchday", "Publica información deportiva, gestiona competiciones y recomienda contenido según la navegación.")
System_Ext(media, "Almacenamiento multimedia", "Conserva escudos, fotografías y portadas.")

Rel(visitor, matchday, "Consulta partidos, equipos, noticias, torneos y recomendaciones", "HTTPS / WebSocket")
Rel(editor, matchday, "Administra noticias", "HTTPS")
Rel(admin, matchday, "Administra la competición", "HTTPS")
Rel(matchday, media, "Lee y escribe archivos multimedia")

SHOW_LEGEND()

note right of matchday
  El nivel de contenedores está en
  architecture/containers.puml.
end note

@enduml
