DJANGO_SECRET_KEY=django-insecure-development-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Origen público opcional para despliegues con proxy o red interna.
# DJANGO_PUBLIC_BASE_URL=https://api.example.com

# Necesario para comunicar ASGI y el monitor de reloj entre procesos.
# REDIS_URL=redis://localhost:6379/0

# Ejecución manual con PostgreSQL. Si DB_ENGINE no se define, Django usa SQLite.
# DB_ENGINE=postgresql
# DB_NAME=matchday
# DB_USER=matchday
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# Docker Compose usa estos valores para crear PostgreSQL. Cambia la contraseña
# antes de usar esta composición fuera del equipo local.
POSTGRES_DB=matchday
POSTGRES_USER=matchday
POSTGRES_PASSWORD=matchday
